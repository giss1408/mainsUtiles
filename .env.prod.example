# Copy to .env.prod on the server (git-ignored) and replace every value.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod ...

# The public host name. Its DNS record must point to the server before the first start.
SITE_DOMAIN=petitgombo.example

# Generate with: openssl rand -hex 48
SECRET_KEY=replace-with-the-output-of-openssl-rand-hex-48

# Generate with: openssl rand -hex 24  (letters and digits only: it goes inside a URL)
POSTGRES_PASSWORD=replace-with-the-output-of-openssl-rand-hex-24

# The only WhatsApp Business number staff may send confirmations from
OFFICIAL_WHATSAPP_NUMBER=

ALLOWED_PHONE_REGIONS=CI
