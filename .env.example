# Copy to .env (git-ignored). Development defaults shown.
DEBUG=1
SECRET_KEY=dev-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DATABASE_URL=postgres://petitgombo:petitgombo@localhost:5432/petitgombo
REDIS_URL=redis://localhost:6379/0
# Providers: dotted path to the implementation class (mocks by default)
MESSAGING_PROVIDER=apps.providers.mocks.MockMessaging
PAYMENT_PROVIDER=apps.providers.mocks.MockPayment
IDENTITY_PROVIDER=apps.providers.mocks.MockIdentity
MAP_PROVIDER=apps.providers.mocks.MockMap
ALLOWED_PHONE_REGIONS=CI
# Device enrolment
ENROLMENT_CODE_TTL_MINUTES=60
ENROLMENT_CODE_MAX_ATTEMPTS=5
ENROLMENT_MAX_PER_PHONE_PER_DAY=3
ENROLMENT_MAX_PER_DEVICE_PER_DAY=3
ENROLMENT_MAX_PER_IP_PER_DAY=10
ENROLMENT_APPLICATION_TTL_DAYS=7
ENROLMENT_RESPONSE_HOURS=24
